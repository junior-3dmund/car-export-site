# Supabase (database) — from supabase.com project settings > API
NEXT_PUBLIC_SUPABASE_URL=REPLACE_WITH_YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_YOUR_SUPABASE_SERVICE_ROLE_KEY

# Cloudinary (image hosting) — from cloudinary.com dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=REPLACE_WITH_YOUR_CLOUD_NAME
CLOUDINARY_UPLOAD_PRESET=REPLACE_WITH_YOUR_UPLOAD_PRESET

# Resend (real inquiry emails) — from resend.com API keys
RESEND_API_KEY=REPLACE_WITH_YOUR_RESEND_API_KEY
INQUIRY_TO_EMAIL=you@example.com

# Simple admin password (swap for real auth later — see README)
ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
# Server-side admin API key to protect admin endpoints (set this in your .env)
ADMIN_API_KEY=REPLACE_WITH_A_STRONG_KEY