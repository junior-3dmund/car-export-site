# Supabase (database) — from supabase.com project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# Cloudinary (image hosting) — from cloudinary.com dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=xxxxx
CLOUDINARY_UPLOAD_PRESET=xxxxx

# Resend (real inquiry emails) — from resend.com API keys
RESEND_API_KEY=xxxxx
INQUIRY_TO_EMAIL=you@yourdomain.com

# Simple admin password (swap for real auth later — see README)
ADMIN_PASSWORD=change-me
